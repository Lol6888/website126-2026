---
import Logo from './Logo.astro';

interface Props {
  lang?: 'en' | 'vi';
  alt?: string; // đường dẫn trang tương ứng ở ngôn ngữ còn lại
  hero?: boolean; // nav nổi trên hero tối (chữ trắng khi ở đầu trang)
}
const { lang = 'en', alt, hero = false } = Astro.props;
const p = lang === 'vi' ? '/vi' : '';

const links =
  lang === 'vi'
    ? [
        { label: 'Dịch Vụ', href: '/vi/services' },
        { label: 'Giải pháp', href: '/vi/solutions' },
        { label: 'Dự án', href: '/vi/work' },
        { label: 'Về chúng tôi', href: '/vi/about' },
      ]
    : [
        { label: 'What We Do', href: '/services' },
        { label: 'Solutions', href: '/solutions' },
        { label: 'Case Studies', href: '/work' },
        { label: 'About Us', href: '/about' },
      ];
---

<nav class="flex items-center justify-between px-5 sm:px-8 md:px-12 py-4 md:py-5">
  <a href={p + '/'} class="fd flex items-center" style="animation-delay:0s" aria-label={lang === 'vi' ? '126Verse – Trang chủ' : '126Verse – Home'}>
    <Logo class="h-8 md:h-9 w-auto" />
  </a>

  <div class="hidden md:flex gap-8 lg:gap-10">
    {links.map((l, i) => (
      <a href={l.href} class="fd label !text-[13px] no-underline hover:opacity-55 transition-opacity" style={`animation-delay:${(i + 1) * 0.1}s`}>{l.label}</a>
    ))}
  </div>

  <div class="flex items-center gap-4">
    {alt && (
      <a href={alt} class="fd label !text-[11px] inline-block px-1.5 py-2 no-underline hover:opacity-55" hreflang={lang === 'vi' ? 'en' : 'vi'} aria-label={lang === 'vi' ? 'English' : 'Tiếng Việt'} style="animation-delay:0.45s">{lang === 'vi' ? 'ENG' : 'VN'}</a>
    )}
    <button id="nav-burger" type="button" class="fd w-9 h-9 rounded-full bg-accent border-0 cursor-pointer flex flex-col items-center justify-center gap-1" style="animation-delay:0.5s" aria-label={lang === 'vi' ? 'Mở menu' : 'Open menu'} aria-expanded="false" aria-controls="nav-menu">
      <span class="w-4 h-0.5 bg-white block pointer-events-none"></span>
      <span class="w-4 h-0.5 bg-white block pointer-events-none"></span>
      <span class="w-4 h-0.5 bg-white block pointer-events-none"></span>
    </button>
  </div>
</nav>
