---
interface Props {
  lang?: 'en' | 'vi';
  hideCta?: boolean;
}
const { lang = 'en', hideCta = false } = Astro.props;
const p = lang === 'vi' ? '/vi' : '';

const cta =
  lang === 'vi'
    ? {
        title: 'Tôi giúp\nbạn nhé!',
        links: [
          { label: 'Liên hệ', href: '/vi/contact' },
          { label: 'Về chúng tôi', href: '/vi/about' },
          { label: 'Just say hello', href: 'mailto:126verse@gmail.com' },
        ],
      }
    : {
        title: 'How can\nwe help?',
        links: [
          { label: 'Work together', href: '/contact' },
          { label: 'Join our team', href: '/about#carreer' },
          { label: 'Just say hello', href: 'mailto:126verse@gmail.com' },
        ],
      };

const bottom = [
  { label: 'Linkedin', href: 'https://www.linkedin.com/company/126verse', ext: true },
  { label: 'Facebook', href: 'https://www.facebook.com/126verse', ext: true },
  { label: 'Twitter', href: 'https://twitter.com/126Verse', ext: true },
  { label: 'Careers', href: p + '/about#carreer' },
  { label: 'Contact', href: p + '/contact' },
  { label: 'Privacy', href: p + '/privacy' },
  { label: 'Accessibility', href: p + '/accessibility' },
];
---

<footer class="mt-24">
  {!hideCta && (
    <section class="px-5 sm:px-8 md:px-12 py-16 md:py-24 hairline" data-reveal>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-10">
        <h2 class="display text-[clamp(2.5rem,7vw,6.5rem)]" style="white-space:pre-line">{cta.title}</h2>
        <div class="flex flex-col gap-5">
          {cta.links.map((l) => (
            <a href={l.href} class="cta-link text-base sm:text-xl">
              {l.label}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="px-5 sm:px-8 md:px-12 py-8 hairline">
    <div class="flex flex-wrap gap-x-6 gap-y-3">
      {bottom.map((l) => (
        <a href={l.href} class="label no-underline text-ink hover:text-accent transition-colors" target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener' : undefined}>{l.label}</a>
      ))}
    </div>
    <p class="display text-[clamp(3rem,12vw,11rem)] mt-10 text-center select-none" aria-hidden="true">126VERSE</p>
  </section>
</footer>
