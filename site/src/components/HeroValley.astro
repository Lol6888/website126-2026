---
// Nền hero trang chủ: thung lũng hoa 3D (src/scripts/hero-valley.ts).
// Máy không có WebGL → quay về video nền cũ (chỉ tải video trong trường hợp đó).
---

<canvas id="hero-valley" class="absolute inset-0 w-full h-full opacity-0 transition-opacity duration-[1600ms]" aria-hidden="true"></canvas>
<video
  id="hero-valley-fallback"
  class="absolute inset-0 w-full h-full object-cover opacity-80"
  data-src="/media/hero-bg.mp4"
  poster="/media/hero-bg.jpg"
  muted
  loop
  playsinline
  hidden
></video>
<!-- viền tối quanh khung hình -->
<div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse at 50% 45%, transparent 45%, rgba(5,3,8,0.75) 100%)"></div>

<script>
  import { initHeroValley } from '../scripts/hero-valley';

  const canvas = document.getElementById('hero-valley') as HTMLCanvasElement;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  try {
    initHeroValley(canvas, { reducedMotion });
    requestAnimationFrame(() => canvas.classList.remove('opacity-0'));
  } catch (err) {
    console.warn('[hero-valley] WebGL unavailable, using video', err);
    canvas.remove();
    const v = document.getElementById('hero-valley-fallback') as HTMLVideoElement;
    v.src = v.dataset.src!;
    v.hidden = false;
    if (!reducedMotion) v.play().catch(() => {});
  }
</script>
