---
import Base from '../layouts/Base.astro';
import { hero, why, testimonials, pricing, modals, compare, versus, faq, addons, finalCta } from '../data/solutions';

const inputCls = 'border-0 border-b border-black/40 bg-transparent py-2 text-base focus:outline-none focus:border-accent';
const arrow = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>`;
---

<Base title="Solutions & Pricing | 126Verse" lang="en" navOverlay hideFooterCta>
  <!-- HERO: tách trên/dưới — dải video phía trên, tiêu đề trên nền đen phía dưới -->
  <section class="bg-ink text-white">
    <!-- VIDEO BAND (full-width, không có chữ đè lên) -->
    <div class="relative w-full overflow-hidden h-[42vh] sm:h-[48vh] lg:h-[58vh]">
      <video class="absolute inset-0 w-full h-full object-cover" src="/media/pricing-hero.mp4" autoplay loop muted playsinline></video>
    </div>

    <!-- TEXT BLOCK -->
    <div class="px-5 sm:px-8 md:px-12 pt-12 md:pt-16 pb-16 md:pb-24">
      <p class="fu text-base md:text-lg leading-relaxed text-white/60 max-w-2xl" style="animation-delay:0.25s;white-space:pre-line">{hero.announce}</p>
      <h1 class="mt-7 md:mt-9" style="line-height:0.98">
        {['Build a Brand', "That's Seen, Trusted,", 'and Remembered'].map((line, li) => (
          <span class="word-line"><span class="word-up display text-[clamp(1.55rem,6vw,5.25rem)]" style={`animation-delay:${0.2 + li * 0.1}s`}>{line}</span></span>
        ))}
      </h1>
      <p class="fu text-lg md:text-2xl leading-relaxed text-white/85 max-w-2xl mt-8 md:mt-10" style="animation-delay:0.55s">{hero.sub}</p>
      <a href="/work" class="fu cta-link text-base sm:text-xl mt-8 inline-flex" style="animation-delay:0.7s;color:#a855f7">{hero.cta}<Fragment set:html={arrow} /></a>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="bg-accent text-white overflow-hidden py-3.5">
    <div class="mq-row flex gap-12 w-max">
      {[...hero.marquee, ...hero.marquee, ...hero.marquee].map((m) => (
        <span class="eyebrow !text-[13px] whitespace-nowrap flex items-center gap-12"><span>{m}</span><span aria-hidden="true">✦</span></span>
      ))}
    </div>
  </div>

  <!-- WHY -->
  <section id="whyus" class="px-5 sm:px-8 md:px-12 py-20 md:py-28">
    <p class="eyebrow-num" data-reveal><span class="n">01</span><span class="rule"></span><span class="eyebrow text-accent">{why.label}</span></p>
    <h2 class="display text-[clamp(1.9rem,5vw,4.5rem)] mt-6 max-w-5xl" style="line-height:1.04" data-reveal set:html={why.title.replace('team', '<br class="hidden md:block">team')}></h2>
    <p class="copy mt-8 max-w-3xl" style="white-space:pre-line" data-reveal>{why.intro}</p>
    <div class="mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {why.values.map((v, i) => (
        <div class="bg-white border border-black/10 rounded-xl p-7 border-t-[3px] border-t-accent" data-reveal style={`transition-delay:${(i % 3) * 0.08}s`}>
          <h3 class="text-xl font-medium leading-snug">{v.t}</h3>
          <p class="copy-sm mt-4">{v.x}</p>
        </div>
      ))}
    </div>
    <div class="mt-24 grid md:grid-cols-2 gap-12 lg:gap-20">
      {why.quotes.map((q) => (
        <figure class="m-0" data-reveal>
          <img src={q.img} alt="" class="w-full max-w-sm h-auto" loading="lazy" />
          <blockquote class="m-0 mt-8 font-semibold text-xl md:text-2xl leading-relaxed" style="white-space:pre-line">{q.q}</blockquote>
          <figcaption class="copy-sm opacity-80 mt-5" style="white-space:pre-line">{q.by}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section id="testimonials01" class="px-5 sm:px-8 md:px-12 py-20 md:py-28" style="background:#f2eefb">
    <p class="eyebrow-num" data-reveal><span class="n">02</span><span class="rule"></span><span class="eyebrow text-accent">{testimonials.label}</span></p>
    <h2 class="display text-[clamp(1.9rem,5vw,4.5rem)] mt-6" data-reveal>{testimonials.title}</h2>
    <p class="font-semibold text-xl md:text-2xl mt-8 max-w-3xl leading-relaxed" style="white-space:pre-line" data-reveal>{testimonials.lead}</p>
    <div class="mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.items.map((t, i) => (
        <figure class="m-0 border border-black/12 rounded-lg p-7 flex flex-col" data-reveal style={`transition-delay:${(i % 3) * 0.08}s`}>
          <p class="text-accent text-lg tracking-[0.25em]" aria-hidden="true">★★★★★</p>
          <blockquote class="m-0 mt-5 copy-sm grow" style="white-space:pre-line">{t.q}</blockquote>
          <figcaption class="mt-7 flex items-center gap-3">
            <img src={t.img} alt="" class="w-11 h-11 rounded-full object-cover" loading="lazy" />
            <span class="text-sm leading-snug font-medium" style="white-space:pre-line">{t.by}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="mt-20 bg-ink text-white rounded-lg p-10 md:p-16 relative overflow-hidden" data-reveal>
      <video class="absolute inset-0 w-full h-full object-cover opacity-40" src="/media/pricing-marquee.mp4" autoplay loop muted playsinline></video>
      <div class="relative z-10">
        <p class="display text-[clamp(1.6rem,4.5vw,4rem)] max-w-4xl" style="line-height:1.08">{testimonials.midMarquee}</p>
        <a href="/audit" target="_blank" class="cta-link text-base sm:text-xl mt-8" style="color:#a855f7">{testimonials.midCta}<Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing_1" class="px-5 sm:px-8 md:px-12 py-20 md:py-28">
    <p class="eyebrow-num" data-reveal><span class="n">03</span><span class="rule"></span><span class="eyebrow text-accent">{pricing.label}</span></p>
    <h2 class="display text-[clamp(1.9rem,5vw,4.5rem)] mt-6 max-w-5xl" style="line-height:1.04" data-reveal set:html={pricing.title.replace('your brand', '<br class="hidden md:block">your brand')}></h2>
    <p class="copy mt-8 max-w-3xl" style="white-space:pre-line" data-reveal>{pricing.sub}</p>
    <div class="mt-16 grid md:grid-cols-2 xl:grid-cols-4 gap-5">
      {pricing.plans.map((p, i) => (
        <div class="bg-white border border-black/10 rounded-xl flex flex-col overflow-hidden hover:border-accent transition-colors" data-reveal style={`transition-delay:${i * 0.08}s`}>
          <div class="bg-[#f2eefb] px-7 pt-7 pb-6 border-b border-black/[0.06]">
            <p class="eyebrow text-accent">{p.price}</p>
            <h3 class="display text-2xl md:text-[1.75rem] mt-3">{p.name}</h3>
            <p class="copy-sm mt-4">{p.desc}</p>
          </div>
          <div class="px-7 pt-6 pb-7 flex flex-col grow">
            <p class="eyebrow text-accent">Goal</p>
            <p class="copy-sm mt-2 font-medium text-black/85">{p.goal}</p>
            <ul class="mt-6 flex flex-col gap-3.5 list-none p-0">
              {p.features.map((f) => (
                <li class="copy-sm flex gap-2.5"><span class="text-accent shrink-0 mt-0.5">✓</span><span>{f}</span></li>
              ))}
            </ul>
            <button type="button" data-modal={p.modal} class="mt-8 self-stretch bg-ink text-white text-sm font-medium px-8 py-4 rounded-md border-0 cursor-pointer hover:bg-accent transition-colors" style="margin-top:auto">{p.cta}</button>
          </div>
        </div>
      ))}
    </div>
    <a href="/contact" class="mt-8 flex items-center justify-between gap-6 border border-black/12 rounded-lg p-7 md:p-8 no-underline text-ink hover:border-accent transition-colors" data-reveal>
      <p class="text-lg md:text-xl leading-relaxed font-medium" style="white-space:pre-line">{pricing.ctaRow}</p>
      <span class="text-accent shrink-0"><Fragment set:html={arrow} /></span>
    </a>
  </section>

  <!-- COMPARE TABLE -->
  <section class="px-5 sm:px-8 md:px-12 py-20 md:py-28 hairline">
    <p class="eyebrow-num" data-reveal><span class="n">04</span><span class="rule"></span><span class="eyebrow text-accent">{compare.label}</span></p>
    <h2 class="display text-[clamp(1.9rem,5vw,4.5rem)] mt-6" data-reveal set:html={compare.title.replace('Package', '<br class="hidden md:block">Package')}></h2>
    <p class="copy mt-6 max-w-2xl" data-reveal>{compare.sub}</p>
    {compare.groups.map((g, gi) => (
      <div class="mt-10 rounded-xl border border-black/12 overflow-hidden bg-white" data-reveal>
        <div class="bg-accent text-white px-5 md:px-6 py-4 flex items-center gap-3">
          <span class="text-white/70 text-sm font-semibold tabular-nums">{'0' + (gi + 1)}</span>
          <h3 class="text-lg md:text-xl font-medium">{g.g}</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse" style="min-width:1180px">
            <thead>
              <tr class="bg-ink text-white">
                {compare.cols.map((c, ci) => (
                  <th class={'text-left p-4 md:p-5 text-base font-medium ' + (ci === 0 ? 'w-[16%]' : 'w-[21%]') + (ci === 0 ? '' : ' border-l border-white/10')}>{c}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {g.rows.map((r, ri) => (
                <tr class={ri % 2 === 1 ? 'bg-[#faf9fd]' : ''}>
                  {r.map((cell, ci) => (
                    <td class={'p-4 md:p-5 border-b border-black/[0.07] align-top text-[17px] leading-relaxed ' + (ci === 0 ? 'font-medium bg-black/[0.02]' : 'text-black/65')} style="white-space:pre-line">{cell}</td>
                  ))}
                </tr>
              ))}
              <tr>
                <td class="p-4 md:p-5 align-top text-[17px] font-medium bg-black/[0.02]">{compare.exchangeRow[0]}</td>
                <td colspan="4" class="p-4 md:p-5 text-[17px] text-black/65">{compare.exchangeRow.slice(1).join('  ·  ')}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    ))}
    <p class="copy-sm opacity-60 mt-10 flex items-center gap-2" data-reveal><span class="text-accent text-lg">ⓘ</span> {compare.note}</p>
  </section>

  <!-- VERSUS TABLE -->
  <section class="px-5 sm:px-8 md:px-12 py-20 md:py-28" style="background:#f2eefb">
    <p class="eyebrow-num" data-reveal><span class="n">05</span><span class="rule"></span><span class="eyebrow text-accent">{versus.label}</span></p>
    <h2 class="display text-[clamp(1.9rem,5vw,4.5rem)] mt-6" data-reveal set:html={versus.title.replace('Or One', '<br class="hidden md:block">Or One')}></h2>
    <p class="font-semibold text-xl md:text-2xl mt-6 max-w-3xl leading-relaxed" data-reveal>{versus.sub}</p>
    <p class="copy mt-5 max-w-3xl" data-reveal>{versus.intro}</p>
    <div class="mt-12 rounded-xl border border-black/12 overflow-hidden bg-white" data-reveal>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" style="min-width:980px">
          <thead>
            <tr class="bg-ink text-white">
              {versus.cols.map((c, ci) => (
                <th class={'text-left p-4 md:p-5 text-base font-medium ' + (ci === 0 ? 'w-[20%]' : 'w-[40%]') + (ci === 2 ? ' bg-accent border-l border-white/15' : ci === 1 ? ' border-l border-white/10' : '')}>{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {versus.rows.map((r, ri) => (
              <tr class={ri % 2 === 1 ? 'bg-[#faf9fd]' : ''}>
                <td class="p-4 md:p-5 border-b border-black/[0.07] align-top text-[17px] leading-relaxed font-medium bg-black/[0.02]">{r[0]}</td>
                <td class="p-4 md:p-5 border-b border-black/[0.07] align-top text-[17px] leading-relaxed text-black/65">{r[1]}</td>
                <td class="p-4 md:p-5 border-b border-black/[0.07] align-top text-[17px] leading-relaxed text-black/85 bg-accent/[0.07] border-l border-accent/15">{r[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="copy opacity-75 mt-10 max-w-4xl flex gap-3" data-reveal><span class="text-accent text-lg shrink-0">ⓘ</span> <span>{versus.conclusion}</span></p>
  </section>

  <!-- FAQ -->
  <section id="faq" class="px-5 sm:px-8 md:px-12 py-20 md:py-28 hairline">
    <p class="eyebrow-num" data-reveal><span class="n">06</span><span class="rule"></span><span class="eyebrow text-accent">{faq.label}</span></p>
    <h2 class="display text-[clamp(1.9rem,5vw,4.5rem)] mt-6" data-reveal set:html={faq.title.replace('without', '<br class="hidden md:block">without')}></h2>
    <div class="mt-12 max-w-4xl flex flex-col" data-reveal>
      {faq.items.map((f) => (
        <details class="group py-6 hairline-soft">
          <summary class="cursor-pointer flex items-center justify-between gap-6 list-none text-lg md:text-xl font-medium leading-snug">
            <span class="group-hover:text-accent transition-colors">{f.q}</span>
            <span class="text-accent text-2xl shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="copy mt-5 max-w-3xl">{f.a}</p>
        </details>
      ))}
    </div>
    <p class="copy-sm opacity-70 mt-10 flex items-center gap-2" data-reveal><span class="text-accent text-lg">ⓘ</span> {faq.note} — <a href="/contact" class="text-accent no-underline font-medium">Contact</a></p>
  </section>

  <!-- ADD-ONS -->
  <section class="px-5 sm:px-8 md:px-12 py-20 md:py-28" style="background:#f2eefb">
    <h2 class="display text-[clamp(1.7rem,4.5vw,4rem)] max-w-5xl" style="line-height:1.06" data-reveal set:html={addons.words.join(' ').replace('with exclusive', '<br class="hidden md:block">with exclusive')}></h2>
    <ul class="mt-12 grid sm:grid-cols-2 gap-5 list-none p-0 max-w-4xl" data-reveal>
      {addons.items.map((a) => (
        <li class="bg-white border border-black/10 rounded-lg px-6 py-5 text-lg leading-relaxed flex gap-3 items-center"><span class="text-accent shrink-0 text-xl">✓</span>{a}</li>
      ))}
    </ul>
    <p class="copy-sm opacity-60 mt-10 flex items-center gap-2" data-reveal><span class="text-accent text-lg">ⓘ</span> {addons.note}</p>
  </section>

  <!-- FINAL CTA -->
  <section class="px-5 sm:px-8 md:px-12 py-24 md:py-36 hairline bg-ink text-white">
    <p class="eyebrow text-white/50" data-reveal>{finalCta.label}</p>
    <p class="display text-[clamp(1.9rem,5vw,4.5rem)] mt-6 max-w-6xl" style="line-height:1.08" data-reveal set:html={finalCta.text.replace("partner, ", 'partner,<br class="hidden md:block"> ').replace('solutions, and', 'solutions,<br class="hidden md:block"> and')}></p>
    <a href="/contact" class="cta-link text-lg sm:text-xl mt-12 inline-flex" style="color:#a855f7" data-reveal>{finalCta.cta}<Fragment set:html={arrow} /></a>
  </section>

  <!-- MODALS -->
  {modals.map((m) => (
    <dialog id={'modal-' + m.id} class="m-auto w-[92vw] max-w-lg border-0 p-0 rounded-lg overflow-hidden backdrop:bg-black/40">
      <div class="bg-ink text-white px-8 py-6">
        <h3 class="display text-xl md:text-2xl" style="white-space:pre-line">{m.title}</h3>
      </div>
      <form name={m.id} method="POST" action="#" class="bg-white p-8 flex flex-col gap-6">
        <p class="copy-sm opacity-70">Please share your details below and our team will reach out within 24 hours to guide you through the onboarding process.</p>
        <label class="flex flex-col gap-2">
          <span class="eyebrow">Your Full Name <em class="not-italic text-accent">*</em></span>
          <input type="text" name="name" placeholder="Your name" required class={inputCls} />
        </label>
        <label class="flex flex-col gap-2">
          <span class="eyebrow">Your Company / Organization <em class="not-italic text-accent">*</em></span>
          <input type="text" name="company" placeholder="Company Name" required class={inputCls} />
        </label>
        <label class="flex flex-col gap-2">
          <span class="eyebrow">Your Email <em class="not-italic text-accent">*</em></span>
          <input type="email" name="email" placeholder="Your email address" required class={inputCls} />
        </label>
        <label class="flex flex-col gap-2">
          <span class="eyebrow">Tell Us About Your Needs</span>
          <textarea name="message" rows="3" placeholder="Additional Notes (optional)" class="border border-black/40 bg-transparent p-3 text-base focus:outline-none focus:border-accent"></textarea>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="confirm" required class="w-4 h-4 accent-[#5E0ED7]" />
          <span class="copy-sm">I agree to the Privacy Policy.</span>
        </label>
        <div class="flex items-center gap-4">
          <button type="submit" class="bg-accent text-white text-sm font-medium px-8 py-3.5 rounded-md border-0 cursor-pointer hover:opacity-80 transition-opacity">{m.submit}</button>
          <button type="button" data-close class="eyebrow opacity-50 bg-transparent border-0 cursor-pointer">Close</button>
        </div>
      </form>
    </dialog>
  ))}

  <style>
    @keyframes mqx { to { transform: translateX(-33.333%); } }
    .mq-row { animation: mqx 18s linear infinite; }
    details summary::-webkit-details-marker { display: none; }
  </style>

  <script>
    document.querySelectorAll('[data-modal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = document.getElementById('modal-' + btn.getAttribute('data-modal'));
        if (d instanceof HTMLDialogElement) d.showModal();
      });
    });
    document.querySelectorAll('dialog [data-close]').forEach((btn) => {
      btn.addEventListener('click', () => btn.closest('dialog')?.close());
    });
  </script>
</Base>
