---
import Base from '../../../layouts/Base.astro';
import { webProjects } from '../../../data/webprojects';
---

<Base title="Web Design | 126Verse" lang="en" hideFooterCta>
  <section class="relative overflow-hidden bg-ink text-white">
    <video class="absolute inset-0 w-full h-full object-cover opacity-60" src="/media/webdesign-bg.mp4" autoplay loop muted playsinline></video>
    <div class="relative z-10 px-5 sm:px-8 md:px-12 py-24 md:py-36">
      <p class="fu label text-white/70" style="animation-delay:0.2s">ONETWENTYSIX VERSE at</p>
      <h1 class="word-line mt-4"><span class="word-up display text-[clamp(2.5rem,11vw,11rem)]" style="animation-delay:0.35s">Web-Design</span></h1>
      <p class="fu label text-white/80 max-w-xl mt-8" style="animation-delay:0.6s">At 126Verse, every website is built around three pillars:
Clarity in structure, Consistency in brand tone, and Conversion through purposeful design.</p>
      <a href="/contact" class="fu cta-link text-base sm:text-xl mt-10" style="animation-delay:0.72s;color:#a855f7">
        Start Your Landing Page
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
      </a>
      <p class="fu label text-white/50 mt-3" style="animation-delay:0.8s">Tell us what you need — we’ll handle the rest.</p>
    </div>
  </section>

  <section class="px-5 sm:px-8 md:px-12 py-16 md:py-24">
    <div class="flex items-baseline justify-between gap-4" data-reveal>
      <h2 class="display text-[clamp(1.6rem,4.5vw,4rem)]">Selected Websites We’ve Crafted</h2>
      <p class="label opacity-50 whitespace-nowrap">Last updated 11-2025</p>
    </div>

    <div class="mt-12 flex flex-col gap-6">
      {webProjects.map((p, i) => (
        <a href={'/work/web-design/' + p.slug} class="group block bg-[#212121] text-white p-6 md:p-10 no-underline" data-reveal>
          <div class="flex items-center justify-between gap-4">
            <p class="label text-white/50">Project</p>
            <p class="label text-white/50 group-hover:text-white transition-colors">Show more</p>
          </div>
          <div class="mt-6 grid md:grid-cols-[1fr_360px] gap-8 items-center">
            <div>
              <p class="display text-[clamp(1.6rem,4vw,3.4rem)] group-hover:text-[#a855f7] transition-colors">{p.name}</p>
              <p class="label text-white/70 mt-4 max-w-xl">{p.card}</p>
              <p class="label text-white/40 mt-6">{p.year}</p>
            </div>
            <img src={p.img} alt={p.name} class="w-full h-56 object-cover" loading="lazy" />
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="px-5 sm:px-8 md:px-12 py-16 md:py-24 hairline" data-reveal>
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
      <p class="font-semibold text-[clamp(1.25rem,3vw,2.25rem)] leading-snug max-w-2xl">Receive your custom cost breakdown within 24 hours</p>
      <a href="/contact" class="cta-link text-base sm:text-xl">
        GET QUOTE
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
      </a>
    </div>
  </section>
</Base>
