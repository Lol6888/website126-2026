---
import Base from '../../../layouts/Base.astro';
import { webProjects } from '../../../data/webprojects';

export function getStaticPaths() {
  return webProjects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
---

<Base title={p.name + ' | 126Verse'} description={p.desc} lang="en" hideFooterCta>
  <article class="bg-ink text-white">
    <header class="px-5 sm:px-8 md:px-12 pt-16 md:pt-24 pb-10">
      <div class="flex items-baseline justify-between gap-4 flex-wrap">
        <p class="fu label text-white/60" style="animation-delay:0.1s">Selected Websites We’ve Crafted</p>
        <p class="fu label text-white/60" style="animation-delay:0.2s">Last updated 11-2025</p>
      </div>
      <a href="/work/web-design" class="fu cta-link label mt-8" style="animation-delay:0.3s;color:#a855f7">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        Back
      </a>
      <p class="fu label text-white/50 mt-10" style="animation-delay:0.35s">Website</p>
      <h1 class="word-line mt-2"><span class="word-up display text-[clamp(2rem,7vw,7rem)]" style="animation-delay:0.45s">{p.name}</span></h1>
      <p class="fu text-base md:text-lg leading-relaxed text-white/80 max-w-2xl mt-6" style="animation-delay:0.6s">{p.desc}</p>
    </header>

    <!-- Ảnh chụp tĩnh (public/img/webdesign/{slug}.webp) hiện mặc định — không phụ thuộc Studio.Design;
         bấm nút mới nạp iframe bản live. -->
    <section class="px-5 sm:px-8 md:px-12 pb-12" data-reveal>
      <div class="relative bg-white" data-preview={p.iframe} data-title={p.name + ' website preview'}>
        <div class="overflow-y-auto" style="max-height:max(75vh,600px)" data-shot tabindex="0" aria-label={p.name + ' website screenshot (scrollable)'}>
          <img src={`/img/webdesign/${p.slug}.webp`} alt={p.name + ' website – full page screenshot'} class="block w-full h-auto" loading="lazy" decoding="async" />
        </div>
        <button type="button" data-live class="absolute bottom-5 right-5 bg-accent text-white label !text-[12px] px-6 py-3.5 rounded-full border-0 cursor-pointer shadow-lg hover:opacity-90 transition-opacity inline-flex items-center gap-2">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>
          View interactive preview
        </button>
      </div>
    </section>

    <section class="px-5 sm:px-8 md:px-12 py-12 grid md:grid-cols-2 gap-12" data-reveal>
      <div>
        <h2 class="display text-2xl md:text-3xl" style="line-height:1.15">{p.durationTitle}</h2>
        <p class="text-base md:text-lg leading-relaxed text-white/70 mt-6" style="white-space:pre-line">{p.durationText}</p>
      </div>
      <div class="flex flex-col gap-10">
        <div>
          <h2 class="display text-2xl md:text-3xl">{p.didLabel}</h2>
          <ul class="mt-5 flex flex-col gap-2 list-none p-0">
            {p.did.map((d) => (
              <li class="text-base md:text-lg leading-relaxed text-white/70">{d}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="display text-2xl md:text-3xl">{p.costTitle}</h2>
          <p class="text-base md:text-lg leading-relaxed text-white/70 mt-5" style="white-space:pre-line">{p.costText}</p>
        </div>
        <div>
          <h2 class="display text-2xl md:text-3xl">{p.outcomeTitle}</h2>
          <p class="text-base md:text-lg leading-relaxed text-white/70 mt-5" style="white-space:pre-line">{p.outcomeText}</p>
        </div>
      </div>
    </section>

    <section class="px-5 sm:px-8 md:px-12 py-16 border-t border-white/20" data-reveal>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
        <p class="font-semibold text-[clamp(1.25rem,3vw,2.25rem)] leading-snug max-w-2xl">Receive your custom cost breakdown within 24 hours</p>
        <a href="/contact" class="cta-link text-base sm:text-xl" style="color:#a855f7">
          GET QUOTE
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
        </a>
      </div>
    </section>
  </article>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-preview]').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('[data-live]');
    btn?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.preview!;
      f.title = box.dataset.title || '';
      f.className = 'w-full h-full border-0 block';
      box.style.height = 'max(75vh, 600px)'; // khung cố định chiều cao cho bản live
      box.querySelector('[data-shot]')?.replaceWith(f);
      btn.remove();
      f.focus({ preventScroll: true });
    });
  });
</script>
