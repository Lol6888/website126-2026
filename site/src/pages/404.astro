---
import Base from '../layouts/Base.astro';
---

<Base title="404 | 126Verse" lang="en" noindex>
  <section class="px-5 sm:px-8 md:px-12 py-24 md:py-40 text-center">
    <h1 class="word-line"><span class="word-up display text-[clamp(4rem,18vw,16rem)] text-accent" style="animation-delay:0.2s">404</span></h1>
    <p class="fu copy mt-6" style="animation-delay:0.4s">Sorry, we couldn’t find that page.</p>
    <p class="fu copy-sm opacity-70 mt-1" lang="vi" style="animation-delay:0.45s">Rất tiếc, trang bạn tìm không tồn tại.</p>
    <div class="fu flex flex-wrap justify-center gap-x-10 gap-y-4 mt-10" style="animation-delay:0.5s">
      <a href="/" class="cta-link text-base sm:text-xl inline-flex">
        Back to home
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
      </a>
      <a href="/vi/" lang="vi" class="cta-link text-base sm:text-xl inline-flex">
        Về trang chủ
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
      </a>
    </div>
  </section>
</Base>
