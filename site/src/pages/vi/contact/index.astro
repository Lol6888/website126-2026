---
import Base from '../../../layouts/Base.astro';

const inputCls = 'border-0 border-b border-black/40 bg-transparent py-2 text-base focus:outline-none focus:border-accent';
---

<Base title="Liên hệ công việc | 126Verse" lang="vi" alt="/contact" hideFooterCta>
  <section class="px-5 sm:px-8 md:px-12 pt-16 md:pt-24 pb-16 grid md:grid-cols-2 gap-16">
    <div>
      <h1 class="word-line"><span class="word-up display text-[clamp(2.5rem,8vw,8rem)]" style="animation-delay:0.2s">Chào bạn.</span></h1>
      <p class="fu copy-sm mt-10 max-w-md" style="animation-delay:0.45s;white-space:pre-line">Không biết chắc nên bắt đầu từ đâu?

Hãy cho chúng tôi biết về sản phẩm, kế hoạch thời gian của bạn, cách bạn biết đến chúng tôi và nơi bạn ở.

Chúng tôi đọc mọi tin nhắn và phản hồi.
Cám ơn bạn vì sự tin tưởng của bạn cho việc liên hệ!

Nếu cần hỗ trợ cụ thể hơn bạn có thể email đến: Sofia_phan@126verse.com</p>
      <a href="/vi/about#carreer" target="_blank" class="fu cta-link label mt-8" style="animation-delay:0.6s">
        Bạn đang tìm việc ư?
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
      </a>
    </div>

    <form name="Contact" method="POST" action="/api/submit" data-mailer class="fu flex flex-col gap-7" style="animation-delay:0.4s">
      <input type="hidden" name="_form" value="Liên hệ (VI)" />
      <input type="hidden" name="_lang" value="vi" />
      <input type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
      <label class="flex flex-col gap-2">
        <span class="label">Tên của bạn <em class="not-italic text-accent">*</em></span>
        <input type="text" name="name" placeholder="Nhập tên của bạn" required class={inputCls} />
      </label>
      <label class="flex flex-col gap-2">
        <span class="label">Email <em class="not-italic text-accent">*</em></span>
        <input type="email" name="email" placeholder="Email Address" required class={inputCls} />
      </label>
      <label class="flex flex-col gap-2">
        <span class="label">Bạn biết đến chúng tôi từ đâu?</span>
        <input type="text" name="source" placeholder="Từ người thân, Twitter..." class={inputCls} />
      </label>
      <label class="flex flex-col gap-2">
        <span class="label">Công ty / dự án của bạn đang ở giai đoạn nào? <em class="not-italic text-accent">*</em></span>
        <select name="stage" required class={inputCls}>
          <option value="">Select one</option>
          <option>Early stage startup</option>
          <option>Mid stage startup</option>
          <option>Late stage startup</option>
          <option>Enterprise</option>
        </select>
      </label>
      <label class="flex flex-col gap-2">
        <span class="label">Lời nhắn <em class="not-italic text-accent">*</em></span>
        <textarea name="message" rows="5" placeholder="Your message here" required class="border border-black/40 bg-transparent p-3 text-base focus:outline-none focus:border-accent"></textarea>
      </label>
      <label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" name="confirm" required class="w-4 h-4 accent-[#5E0ED7]" />
        <span class="label">Tôi đã đọc và đồng ý về các điều khoản.</span>
      </label>
      <button type="submit" class="self-start bg-ink text-white label !text-[13px] px-12 py-4 border-0 cursor-pointer hover:bg-accent transition-colors">Gửi</button>
    </form>
  </section>
</Base>
