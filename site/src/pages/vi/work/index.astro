---
import { caseList } from '../../../data/caseList';
import Media from '../../../components/Media.astro';
import Base from '../../../layouts/Base.astro';

const items = [
  { name: 'Web Design', tag: 'Các website tiêu biểu', href: '/work/web-design', img: '/img/a/s-1231x884_v-fms_webp_c9d174ed-82ab-4aaa-91c1-b4164d885a4c.webp' },
  ...caseList('vi').map((c) => ({ name: c.name, tag: c.type, href: c.href, img: c.img })),
];
---

<Base title="Dự án | 126Verse" lang="vi" alt="/work">
  <section class="px-5 sm:px-8 md:px-12 pt-16 md:pt-24 pb-12">
    <h1 class="word-line"><span class="word-up display text-[clamp(2.5rem,9vw,9rem)]" style="animation-delay:0.2s">Dự án</span></h1>
  </section>

  <section class="px-5 sm:px-8 md:px-12 pb-12">
    <div class="flex flex-col">
      {items.map((it, i) => (
        <a href={it.href} class="group py-8 md:py-10 hairline grid grid-cols-[1fr_auto] md:grid-cols-[80px_1fr_280px_auto] gap-4 md:gap-8 items-center no-underline text-ink" data-reveal>
          <p class="hidden md:block text-2xl font-semibold leading-none"><span class="num-accent">0</span>{i + 1}</p>
          <div>
            <p class="display text-[clamp(1.5rem,4.5vw,3.6rem)] group-hover:text-accent transition-colors">{it.name}</p>
            <p class="label opacity-60 mt-2">{it.tag}</p>
          </div>
          <Media src={it.img} alt={it.name} class="img-shadow hidden md:block w-full h-36 object-cover" />
          <svg class="w-8 h-8 md:w-12 md:h-12 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
        </a>
      ))}
    </div>
  </section>
</Base>
