---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import NavMenu from '../components/NavMenu.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'vi';
  alt?: string;
  hideFooterCta?: boolean;
  bare?: boolean; // không nav/footer (vd: coming soon)
  navOverlay?: boolean; // nav nổi trên hero video
  dark?: boolean; // nền tối cho cả trang (vd: Mars Cats Voyage)
}
const { title, description = '', lang = 'en', alt, hideFooterCta = false, bare = false, navOverlay = false, dark = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {alt && <link rel="alternate" hreflang={lang === 'vi' ? 'en' : 'vi'} href={alt} />}
  </head>
  <body class={dark ? 'theme-dark' : undefined}>
    {!bare && (
      <a href="#main" class="skip-link label">{lang === 'vi' ? 'Bỏ qua, tới nội dung chính' : 'Skip to main content'}</a>
    )}
    {!bare && (
      <header id="site-header" class={(navOverlay ? 'fixed site-header-hero' : 'sticky site-header-solid') + ' top-0 inset-x-0 z-50'}>
        <Nav lang={lang} alt={alt} hero={navOverlay} />
      </header>
    )}
    {!bare && <NavMenu lang={lang} />}
    <main id="main"><slot /></main>
    {!bare && <Footer lang={lang} hideCta={hideFooterCta} dark={dark} />}

    <script>
      // header neo: trang hero (fixed) đổi nền khi cuộn qua hero
      const header = document.getElementById('site-header');
      if (header && header.classList.contains('site-header-hero')) {
        const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Tôn trọng giảm chuyển động: dừng video nền autoplay
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('video[autoplay]').forEach((v) => {
          v.removeAttribute('autoplay');
          v.pause();
        });
      }

      // ─── Gửi form qua /api/submit (không tải lại trang) ──────────────────
      const isVI = document.documentElement.lang === 'vi';
      const T = isVI
        ? {
            sending: 'Đang gửi…',
            ok: 'Cảm ơn bạn! Chúng tôi đã nhận được thông tin và sẽ phản hồi sớm nhất.',
            err: 'Rất tiếc, gửi chưa thành công. Vui lòng thử lại hoặc email tới 126verse@gmail.com.',
          }
        : {
            sending: 'Sending…',
            ok: "Thank you! We've received your message and will be in touch shortly.",
            err: 'Sorry, something went wrong. Please try again or email 126verse@gmail.com.',
          };

      document.querySelectorAll('form[data-mailer]').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const f = e.currentTarget as HTMLFormElement;
          const btn = f.querySelector('button[type="submit"]') as HTMLButtonElement | null;

          // Dọn thông báo lỗi cũ (nếu có)
          f.querySelector('[data-form-error]')?.remove();

          const original = btn?.textContent || '';
          if (btn) {
            btn.disabled = true;
            btn.textContent = T.sending;
            btn.style.opacity = '0.6';
          }

          try {
            const res = await fetch('/api/submit', { method: 'POST', body: new FormData(f) });
            const data = await res.json().catch(() => ({ success: res.ok }));

            if (res.ok && data.success) {
              f.innerHTML =
                '<div style="border:1px solid var(--accent,#5E0ED7);border-left-width:3px;padding:22px 24px;background:#f6f4fb">' +
                '<p style="font-weight:600;font-size:17px;margin:0 0 6px">✓ ' +
                (isVI ? 'Đã gửi thành công' : 'Sent successfully') +
                '</p><p style="margin:0;opacity:.8;line-height:1.5">' +
                T.ok +
                '</p></div>';
              f.scrollIntoView({ behavior: 'smooth', block: 'center' });
              return;
            }
            throw new Error(data.message || T.err);
          } catch (err) {
            const msg = document.createElement('p');
            msg.setAttribute('data-form-error', '');
            msg.style.cssText = 'color:#c0152f;font-size:14px;margin:0';
            msg.textContent = (err as Error)?.message || T.err;
            btn?.insertAdjacentElement('afterend', msg);
            if (btn) {
              btn.disabled = false;
              btn.textContent = original;
              btn.style.opacity = '';
            }
          }
        });
      });
    </script>
  </body>
</html>
