---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import NavMenu from '../components/NavMenu.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'vi';
  alt?: string;
  hideFooterCta?: boolean;
  bare?: boolean; // không nav/footer (vd: coming soon)
  navOverlay?: boolean; // nav nổi trên hero video
  dark?: boolean; // nền tối cho cả trang (vd: Mars Cats Voyage)
  noindex?: boolean;
  image?: string; // ảnh OG riêng (đường dẫn tuyệt đối trong site)
}
const { title, description, lang = 'en', alt, hideFooterCta = false, bare = false, navOverlay = false, dark = false, noindex = false, image = '/og.png' } = Astro.props;

// Mô tả mặc định (nguyên văn meta description trang chủ) khi trang không truyền riêng.
const DEFAULT_DESC = {
  en: '126Verse provides high-quality web design and development services, helping top companies like FamilyMart, Yamaha, and Daesang create amazing product designs and services.',
  vi: '126Verse chuyên cung cấp dịch vụ thiết kế sáng tạo, xây dựng thương hiệu, cải thiện UI/UX, phát triển E-learning và thiết kế đồ họa cho doanh nghiệp toàn cầu.',
};
// Gộp khoảng trắng và cắt ~160 ký tự theo ranh giới từ (trang có thể truyền nguyên đoạn văn).
const clean = (description || DEFAULT_DESC[lang]).replace(/\s+/g, ' ').trim();
const desc = clean.length > 160 ? clean.slice(0, 157).replace(/\s+\S*$/, '') + '…' : clean;
const site = Astro.site!;
// URL chuẩn: không có "/" cuối (trừ trang gốc) — khớp link nội bộ và sitemap.
const abs = (p: string) => new URL(p.length > 1 ? p.replace(/\/+$/, '') : p, site).href;
const canonical = abs(Astro.url.pathname);
const enHref = abs(lang === 'en' ? Astro.url.pathname : alt || '/');
const viHref = alt || lang === 'vi' ? abs(lang === 'vi' ? Astro.url.pathname : alt!) : undefined;
const ogImage = new URL(image, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {viHref && (
      <>
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="vi" href={viHref} />
        <link rel="alternate" hreflang="x-default" href={enHref} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="126Verse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@126Verse" />
    <meta name="theme-color" content="#5E0ED7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class={dark ? 'theme-dark' : undefined}>
    {!bare && (
      <a href="#main" class="skip-link label">{lang === 'vi' ? 'Bỏ qua, tới nội dung chính' : 'Skip to main content'}</a>
    )}
    {!bare && (
      <header id="site-header" class={(navOverlay ? 'fixed site-header-hero' : 'sticky site-header-solid') + ' top-0 inset-x-0 z-50'}>
        <Nav lang={lang} alt={alt} hero={navOverlay} />
      </header>
    )}
    {!bare && <NavMenu lang={lang} />}
    <main id="main"><slot /></main>
    {!bare && <Footer lang={lang} hideCta={hideFooterCta} dark={dark} />}

    <script>
      // header neo: trang hero (fixed) đổi nền khi cuộn qua hero
      const header = document.getElementById('site-header');
      if (header && header.classList.contains('site-header-hero')) {
        const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Tôn trọng giảm chuyển động: dừng video nền autoplay
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        document.querySelectorAll('video[autoplay]').forEach((v) => {
          v.removeAttribute('autoplay');
          v.pause();
        });
      }
      // Video thay GIF (components/Media.astro): chỉ tải & phát khi gần vào màn hình.
      // Khai báo ở cấp module để observer không bị garbage-collect.
      const vio = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) v.play().catch(() => {});
            else v.pause();
          }
        },
        { rootMargin: '200px 0px' }
      );
      if (!reduceMotion) document.querySelectorAll('video[data-autoplay]').forEach((v) => vio.observe(v));

      // ─── Gửi form qua /api/submit (không tải lại trang) ──────────────────
      const isVI = document.documentElement.lang === 'vi';
      const T = isVI
        ? {
            sending: 'Đang gửi…',
            ok: 'Cảm ơn bạn! Chúng tôi đã nhận được thông tin và sẽ phản hồi sớm nhất.',
            err: 'Rất tiếc, gửi chưa thành công. Vui lòng thử lại hoặc email tới sofia_phan@126verse.com.',
            big: 'Tổng dung lượng file đính kèm vượt quá 4MB. Vui lòng nén file hoặc gửi link (Google Drive, Dropbox…).',
          }
        : {
            sending: 'Sending…',
            ok: "Thank you! We've received your message and will be in touch shortly.",
            err: 'Sorry, something went wrong. Please try again or email sofia_phan@126verse.com.',
            big: 'Attachments exceed 4MB in total. Please compress your files or share a link (Google Drive, Dropbox…).',
          };
      // Vercel giới hạn body request 4.5MB — chặn trước ở client để báo lỗi rõ ràng.
      const MAX_UPLOAD = 4 * 1024 * 1024;

      const showError = (f: HTMLFormElement, text: string) => {
        const btn = f.querySelector('button[type="submit"]');
        const msg = document.createElement('p');
        msg.setAttribute('data-form-error', '');
        msg.setAttribute('role', 'alert');
        msg.style.cssText = 'color:#c0152f;font-size:14px;margin:0';
        msg.textContent = text;
        (btn?.parentElement?.tagName === 'DIV' ? btn.parentElement : btn)?.insertAdjacentElement('afterend', msg);
      };

      document.querySelectorAll('form[data-mailer]').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const f = e.currentTarget as HTMLFormElement;
          const btn = f.querySelector('button[type="submit"]') as HTMLButtonElement | null;

          // Dọn thông báo lỗi cũ (nếu có)
          f.querySelector('[data-form-error]')?.remove();

          let bytes = 0;
          f.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach((i) => {
            for (const file of Array.from(i.files || [])) bytes += file.size;
          });
          if (bytes > MAX_UPLOAD) {
            showError(f, T.big);
            return;
          }

          const original = btn?.textContent || '';
          if (btn) {
            btn.disabled = true;
            btn.textContent = T.sending;
            btn.style.opacity = '0.6';
          }

          try {
            const res = await fetch('/api/submit', { method: 'POST', body: new FormData(f) });
            const data = await res.json().catch(() => ({ success: false }));

            if (res.ok && data.success) {
              const box = document.createElement('div');
              box.setAttribute('role', 'status');
              box.style.cssText = 'border:1px solid var(--accent,#5E0ED7);border-left-width:3px;padding:22px 24px;background:#f6f4fb;color:#15131a';
              box.innerHTML =
                '<p style="font-weight:600;font-size:17px;margin:0 0 6px">✓ ' +
                (isVI ? 'Đã gửi thành công' : 'Sent successfully') +
                '</p><p style="margin:0;opacity:.8;line-height:1.5">' +
                T.ok +
                '</p>';
              // Giữ lại nút đóng (form trong modal) để người dùng vẫn đóng được.
              f.replaceChildren(box, ...Array.from(f.querySelectorAll('[data-close]')));
              f.scrollIntoView({ behavior: 'smooth', block: 'center' });
              return;
            }
            throw new Error(res.status === 413 ? T.big : T.err);
          } catch (err) {
            showError(f, err instanceof Error && err.message === T.big ? T.big : T.err);
            if (btn) {
              btn.disabled = false;
              btn.textContent = original;
              btn.style.opacity = '';
            }
          }
        });
      });
    </script>
  </body>
</html>
